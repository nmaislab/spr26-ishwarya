F7E6;strokeColor=#D9A441;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="170" y="244" width="510" height="78" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b&gt;Decision Matrix Construction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;rows = APIs; columns = rt_s (cost), tp_kbps (benefit), availability (benefit)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=0;fillColor=#EEFDF3;strokeColor=#72B482;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="150" y="410" width="550" height="76" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;Normalize and Weight Matrix&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;w = (1/3, 1/3, 1/3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=0;fillColor=#EEF2FF;strokeColor=#7C8AE5;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="220" y="528" width="410" height="64" as="geometry" /></mxCell><mxCell id="b5" value="&lt;b&gt;Ideal Reference Points&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Best: min rt_s, max tp_kbps, max availability&lt;br&gt;Worst: max rt_s, min tp_kbps, min availability&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=0;fillColor=#FDF2F8;strokeColor=#C97AA0;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="145" y="632" width="560" height="82" as="geometry" /></mxCell><mxCell id="b6" value="&lt;b&gt;Distance and Closeness Calculation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;D_i+, D_i-&lt;br&gt;C_i = D_i- / (D_i+ + D_i-)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=0;fillColor=#F0F9FF;strokeColor=#64A6C2;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="205" y="746" width="440" height="78" as="geometry" /></mxCell><mxCell id="b7" value="&lt;b&gt;Rank by Descending TOPSIS Score&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;output: QoS rank for Subtask S_j&lt;br&gt;used by qos_topsis / qos_hybrid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;shadow=0;fillColor=#E6F4F1;strokeColor=#4F9A8B;strokeWidth=1.5;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=10;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="200" y="914" width="450" height="72" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.6;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.6;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.6;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=1.6;" edge="1" pare