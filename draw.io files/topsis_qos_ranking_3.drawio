<mxfile host="app.diagrams.net" modified="2026-06-03T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="topsisQoSProcessResearchGrade" name="TOPSIS QoS Ranking Process"><mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="outer" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;arcSize=3;fontColor=#0F172A;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="62" y="28" width="726" height="1010" as="geometry" /></mxCell><mxCell id="title" value="TOPSIS QoS Ranking Process" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="110" y="48" width="630" height="34" as="geometry" /></mxCell><mxCell id="subtitle" value="Per-subtask QoS ranking flow used to order valid retrieved API candidates" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="125" y="82" width="600" height="24" as="geometry" /></mxCell><mxCell id="sec1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=8;fontColor=#334155;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="115" y="120" width="620" height="222" as="geometry" /></mxCell><mxCell id="sec2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=8;fontColor=#334155;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="115" y="370" width="620" height="472" as="geometry" /></mxCell><mxCell id="sec3" value="" style="rounded=1;whiteSpace=wrap;html=